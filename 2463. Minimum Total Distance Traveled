from functools import lru_cache
from typing import List

class Solution:
    def minimumTotalDistance(self, robot: List[int], factory: List[List[int]]) -> int:
        robot.sort()
        factory.sort()

        m = len(robot)
        n = len(factory)

        @lru_cache(None)
        def dp(i, j):
            if i == m:
                return 0
            if j == n:
                return float("inf")

            res = dp(i, j + 1)

            dist = 0
            pos, limit = factory[j]

            for k in range(1, min(limit, m - i) + 1):
                dist += abs(robot[i + k - 1] - pos)
                res = min(res, dist + dp(i + k, j + 1))

            return res

        return dp(0, 0)
